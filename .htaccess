DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Qualquer rota que não seja um arquivo real volta para a página em construção.
    # 302 para o navegador não gravar o redirecionamento quando o site voltar.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /index.html [R=302,L]
</IfModule>
